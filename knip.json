{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/assert-package.mjs"],
      "ignoreDependencies": ["@earendil-works/pi-coding-agent", "@earendil-works/pi-tui", "typebox"]
    },
    "packages/permissions": {
      "entry": ["extensions/index.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "extensions/**/*.ts", "test/**/*.ts"]
    },
    "packages/rewind": {
      "entry": ["extensions/index.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "extensions/**/*.ts", "test/**/*.ts"]
    }
  }
}
