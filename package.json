{
  "name": "pi-kit",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.base.json",
    "lint": "biome ci .",
    "format": "biome check --write .",
