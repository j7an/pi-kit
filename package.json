    "test": "sh scripts/check-package.sh && node --test",
    "check": "pnpm typecheck && pnpm lint && pnpm knip && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@earendil-works/pi-coding-agent": "1.0.2",
    "@earendil-works/pi-tui": "1.0.2",
    "@types/node": "26.6.3",
    "knip": "6.38.0",
    "typebox": "1.3.34",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@12.8.2"
}
